<% layout('layouts/boilerplate') %>

    <section class="row justify-content-center align-items-center" style="min-height: calc(100vh - 220px);">
        <div class="col-12 col-md-8 col-lg-5 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4">
                <img src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                    class="card-img-top rounded-top-4 object-fit-cover" style="height: 180px;"
                    alt="Camp tent under the stars">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 fw-semibold mb-1 text-center">Welcome back</h1>
                    <p class="text-secondary text-center mb-4">Log in to continue to YelpCamp</p>

                    <form action="/login" method="POST" class="validated-form" novalidate>
                        <div class="form-floating mb-3">
                            <input class="form-control" type="text" id="username" name="username" placeholder="Username"
                                required autocomplete="username">
                            <label for="username">Username</label>
                            <div class="invalid-feedback">Please enter your username.</div>
                        </div>

                        <div class="form-floating mb-4">
                            <input class="form-control" type="password" id="password" name="password"
                                placeholder="Password" required autocomplete="current-password">
                            <label for="password">Password</label>
                            <div class="invalid-feedback">Please enter your password.</div>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-dark btn-lg">Log In</button>
                        </div>
                    </form>

                    <p class="text-center text-secondary mt-4 mb-0">Don't have an account? <a href="/register"
                            class="link-dark fw-semibold text-decoration-none">Sign up</a></p>
                </div>
            </div>
        </div>
    </section>